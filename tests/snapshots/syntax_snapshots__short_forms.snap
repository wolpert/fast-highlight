---
source: tests/syntax_snapshots.rs
expression: "render(input, ParseOptions::default())"
---
input: "for x (a b) echo $x; if [[ a ]] { b } else { c }; repeat 2 { d }"
spans:
  0..3 reserved-word "for"
  6..7 grouping "("
  10..11 grouping ")"
  17..19 parameter "$x"
  19..20 separator ";"
  21..23 reserved-word "if"
  24..26 reserved-word "[["
  29..31 reserved-word "]]"
  32..33 reserved-word "{"
  36..37 reserved-word "}"
  38..42 reserved-word "else"
  43..44 reserved-word "{"
  47..48 reserved-word "}"
  48..49 separator ";"
  50..56 reserved-word "repeat"
  59..60 reserved-word "{"
  63..64 reserved-word "}"
commands:
  "echo" | "$x" (expanded)
  "b"
  "c"
  "d"
path words:
  "a"
  "b"
  "a"
