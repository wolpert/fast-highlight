---
source: tests/syntax_snapshots.rs
expression: "render(input, ParseOptions::default())"
---
input: "echo {a,b} {1..3} {x} ~/foo ~ 'q w' \"e\"r a\\ b !! !$:h"
spans:
  5..10 brace-expansion "{a,b}"
  11..17 brace-expansion "{1..3}"
  30..35 single-quoted "'q w'"
  36..39 double-quoted "\"e\""
  42..44 escape "\\ "
  46..48 history-expansion "!!"
  49..53 history-expansion "!$:h"
commands:
  "echo" | "{a,b}" (expanded) | "{1..3}" (expanded) | "{x}" | "~/foo" (tilde) | "~" (tilde) | "'q w'" (literal "q w") | "\"e\"r" (literal "er") | "a\\ b" (literal "a b") | "!!" (expanded) | "!$:h" (expanded)
